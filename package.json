{
  "name": "and-music",
  "version": "1.0.0",
  "description": "Desktop music player — (&) Music",
  "main": "./out/main/index.js",
  "author": "(&) Music Team",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --test tests/*.test.cjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview .",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux AppImage --publish never --config.directories.output=bin"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "howler": "^2.2.4",
    "music-metadata": "^9.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@tanstack/react-virtual": "^3.0.1",
    "@types/howler": "^2.2.11",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "lucide-react": "^0.315.0",
    "postcss": "^8.4.35",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "zustand": "^4.5.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "esbuild@0.21.5": true
  }
}
